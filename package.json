{
  "name": "ts-node-template",
  "version": "0.0.0-unversioned",
  "description": "Template for a TS-Node project",
  "license": "UNLICENSED",
  "private": true,
  "author": "Patrick Camacho <patrick@camacho.io>",
  "main": "src/index.ts",
  "scripts": {
    "format": "prettier --write . && format-package --write",
    "lint": "eslint . --ext .ts,.js",
    "prepare": "husky install",
    "start": "ts-node src/index.ts",
    "test": "jest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.1.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.27",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "commitlint": "^19.1.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest-extended": "^2.0.0",
    "format-package": "^7.0.0",
    "husky": "^9.0.11",
    "install-deps-postmerge": "^2.0.1",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2",
    "utility-types": "^3.11.0"
  }
