{
  "name": "ts-node-template",
  "version": "0.0.0-unversioned",
  "description": "Template for a TS-Node project",
  "license": "UNLICENSED",
  "private": true,
  "author": "Patrick Camacho <patrick@camacho.io>",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "dev": "NODE_ENV=development ts-node src/index.ts",
    "format": "prettier --write . && format-package --write",
    "lint": "eslint --fix .",
    "prepare": "husky",
    "start": "NODE_ENV=production tsx src/index.ts",
    "test": "echo \"no tests\"",
    "type-check": "tsc --noEmit",
    "watch": "NODE_ENV=development ts-node-dev --respawn --exit-child src/index.ts"
  },
  "dependencies": {
    "dotenv-flow": "^4.1.0",
    "envalid": "^8.1.0",
    "pino": "^8.21.0",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.37.0",
    "@swc/core": "^1.13.5",
    "@swc/helpers": "^0.5.17",
    "@types/node": "^22.10.1",
    "commitlint": "^19.6.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-xo": "^0.49.0",
    "eslint-config-xo-typescript": "^9.0.0",
    "format-package": "^7.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "install-deps-postmerge": "^2.0.1",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "regenerator-runtime": "^0.14.1",
    "rimraf": "^6.0.1",
    "stylistic": "^0.2.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.0",
    "utility-types": "^3.11.0"
  }
}
